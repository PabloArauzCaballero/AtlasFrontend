# Base de la API de AtlasBackend.
# `localhost` NO sirve en el emulador: apunta al propio emulador. Usa la IP LAN de tu equipo.
EXPO_PUBLIC_ATLAS_API_URL=http://192.168.0.197:3105/api/v1

# Tenant al que pertenece el cliente (cabecera x-tenant-id).
EXPO_PUBLIC_ATLAS_TENANT_ID=1

# Tiempo maximo por peticion, en milisegundos.
EXPO_PUBLIC_ATLAS_TIMEOUT_MS=20000

# Origen del dominio de compra: `sandbox` (motor local V3) o `live` (backend, cuando exista).
EXPO_PUBLIC_ATLAS_PURCHASE_SOURCE=sandbox
EXPO_PUBLIC_ATLAS_DECISION_SOURCE=backend

# Escaner de documentos del sistema (VisionKit / ML Kit) para el carnet. Solo `true` o `1` lo encienden.
# En los perfiles de EAS (preview, production) va encendido; aqui se apaga por omision porque el
# emulador no tiene camara real.
EXPO_PUBLIC_ATLAS_ESCANER_DOCUMENTO=false

# Este .env es SOLO para desarrollo local. Los builds y los `eas update` leen eas.json y el entorno
# EAS del mismo nombre (`npx eas-cli env:list preview`); `npm run qa:doctor` comprueba que coinciden.
# Todo EXPO_PUBLIC_* acaba dentro del bundle: aqui nunca va un secreto.

# --- Mapa del domicilio en ANDROID -------------------------------------------
#
# `expo-maps` usa Apple Maps en iOS (sin clave) y Google Maps en Android, que exige una clave de
# Google Cloud con la Maps SDK for Android habilitada y restringida al paquete `bo.atlas.consumer`
# mas la huella SHA-1 del certificado de firma. Sin ella el mapa se monta en gris, sin error.
#
# Se lee al construir (`app.config.js`) y NO se versiona.
ANDROID_MAPS_API_KEY=
