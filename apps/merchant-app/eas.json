{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_ATLAS_API_URL": "https://atlas.erp.test.arauzsoftware.com/api/v1", "EXPO_PUBLIC_ATLAS_TIMEOUT_MS": "20000" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false, "autoIncrement": true },
      "env": { "EXPO_PUBLIC_ATLAS_API_URL": "https://atlas.erp.test.arauzsoftware.com/api/v1", "EXPO_PUBLIC_ATLAS_TIMEOUT_MS": "20000" }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "ios": { "autoIncrement": true },
      "env": { "EXPO_PUBLIC_ATLAS_API_URL": "https://atlas.erp.test.arauzsoftware.com/api/v1", "EXPO_PUBLIC_ATLAS_TIMEOUT_MS": "20000" }
    },
    "testflight-test": {
      "extends": "production",
      "channel": "testflight-test",
      "environment": "production",
      "env": { "EXPO_PUBLIC_ATLAS_API_URL": "https://atlas.erp.test.arauzsoftware.com/api/v1" }
    },
    "simulador-ios": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_ATLAS_API_URL": "https://atlas.erp.test.arauzsoftware.com/api/v1", "EXPO_PUBLIC_ATLAS_TIMEOUT_MS": "20000" }
    }
  }
}
