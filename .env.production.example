# Plantilla del entorno de PRODUCCION de la app del cliente final.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
#  AQUI NO VA NINGUN SECRETO. NUNCA.
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# Todo lo que empieza por `EXPO_PUBLIC_` se INLINEA en el bundle de JavaScript. Cualquiera que
# descargue el APK o el IPA puede leerlo con un editor de texto: no es configuracion privada, es
# contenido publico de la aplicacion. Una llave de API, un token de servicio o una credencial de
# proveedor puestos aqui se consideran comprometidos desde el primer despliegue.
#
# Lo que la app necesita saber del servidor son DIRECCIONES y MODOS, no permisos. Los permisos los
# obtiene el usuario al autenticarse, y viven en el llavero seguro del dispositivo.
#
# Copiar a `.env.production` en la maquina o el runner que construye el binario. Ese fichero no se
# versiona.

# ── Direccion de la API ───────────────────────────────────────────────────────────────────────
#
# HTTPS OBLIGATORIO. Android bloquea el trafico en claro desde API 28 y iOS lo bloquea con ATS;
# ambos se pueden desactivar, y desactivarlos publicaria los tokens de sesion de cada cliente en
# cualquier wifi. Si la URL no empieza por `https://`, el despliegue esta mal.
#
# El host debe ser un nombre, no una IP: un certificado se emite para un nombre, y una IP fija
# convierte cualquier migracion de infraestructura en una version nueva de la app en las tiendas.
EXPO_PUBLIC_ATLAS_API_URL=https://api.atlas.bo/api/v1

# ── Tenant ────────────────────────────────────────────────────────────────────────────────────
#
# Viaja como cabecera `x-tenant-id`. El servidor NO confia en este valor para decidir a que datos
# se accede —eso lo resuelve con el token del cliente—, pero enviar el equivocado hace que la app
# pida catalogos y consentimientos de otra organizacion.
EXPO_PUBLIC_ATLAS_TENANT_ID=1

# ── Tiempo maximo por peticion ────────────────────────────────────────────────────────────────
#
# En milisegundos. Mas alto que en desarrollo: una red movil boliviana con mala cobertura tarda
# mas que una LAN, y un corte prematuro se le presenta al cliente como «sin conexion» cuando el
# servidor si estaba respondiendo. Mas de 30 s tampoco sirve: a esa altura la persona ya se fue.
EXPO_PUBLIC_ATLAS_TIMEOUT_MS=30000

# ── Origen del dominio de COMPRA ──────────────────────────────────────────────────────────────
#
# `live` es el unico valor admisible en produccion.
#
# `sandbox` corre el motor de demostracion que vive en `src/sandbox`: ordenes, calendarios e
# instrucciones de pago calculados en el telefono. Publicar con `sandbox` significa mostrarle a un
# cliente real un plan de cuotas que ningun servidor conoce y una instruccion de pago que nadie va
# a conciliar. La pantalla lo declara, pero eso no lo hace aceptable.
#
# ATENCION: mientras AtlasBackend no exponga el dominio V3 (`purchase_order`,
# `purchase_commitment`, `payment_schedule`), poner `live` deja el flujo de compra sin backend
# contra el que hablar. Es decir: hoy esta variable BLOQUEA el lanzamiento, y esa es exactamente
# la senal que tiene que dar.
EXPO_PUBLIC_ATLAS_PURCHASE_SOURCE=live

# ── Quien decide el credito ───────────────────────────────────────────────────────────────────
#
# `backend` es el unico valor admisible en produccion, y ya es el valor por defecto del codigo.
#
# Con `backend`, la app manda monto y plazo a `POST /customers/:id/credit-applications`;
# AtlasBackend proyecta las features del cliente, consulta al motor de decision y devuelve el
# expediente resuelto con su `executionId`. La app no puntua, no aprueba y no decide.
#
# `local` existe solo para demostraciones sin backend y se declara en pantalla como tal. En
# produccion equivaldria a conceder credito desde el telefono.
EXPO_PUBLIC_ATLAS_DECISION_SOURCE=backend

# ─────────────────────────────────────────────────────────────────────────────────────────────
#  Lo que NO se configura aqui, y donde vive
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
#   Credenciales del cliente        → llavero del dispositivo (`expo-secure-store`), nunca en el bundle
#   Llaves del motor de decision    → variables del servidor de AtlasBackend; la app no lo llama
#   Credenciales de almacenamiento  → el backend firma cada URL de subida; la app solo la usa
#   Certificados y pinning          → configuracion nativa, no variables de entorno
#   Claves de notificaciones push   → credenciales del proyecto en Expo/FCM/APNs
