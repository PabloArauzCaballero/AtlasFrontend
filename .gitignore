# Dependencias
node_modules/

# Turborepo
.turbo/

# Compilaciones nativas: se regeneran con `expo prebuild` y pesan cientos de megas.
# Ademas guardan rutas absolutas de la maquina que las genero, asi que versionarlas
# rompe la compilacion de cualquier otro equipo.
apps/*/android/
apps/*/ios/
apps/*/.expo/

# Entorno local. `\.env.example` y `\.env.production.example` SI se versionan:
# son la plantilla, y no llevan ningun valor real.
.env
.env.local
.env*.local

# Sistema
.DS_Store
Thumbs.db

# ATL-013 — Secretos: cualquier fichero .env queda fuera del repositorio, salvo las plantillas.
# Las reglas anteriores enumeraban variantes concretas (.env, .env.local, .env.bak-*), así que un
# nombre no previsto —`.env.bak`, el más probable al hacer una copia rápida— no coincidía con
# ninguna y quedaba listo para commitear. Se invierte: se ignora todo y se readmiten los ejemplos.
.env*
!.env*.example
